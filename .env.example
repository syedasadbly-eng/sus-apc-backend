# ============================================
# SUS APC Backend — Environment Variables
# ============================================
# Copy this file to .env and edit as needed.
# All values have sensible defaults in server.js.

# Server
PORT=3001

# Database (SQLite file path)
DB_PATH=./apc_data.db

# MQTT Broker (HiveMQ Cloud)
MQTT_HOST=492260d5d94c4b4e87ade94ae81925e6.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=sus-dashboard
MQTT_PASS=SuS-Mqtt#2026!Secure
MQTT_TOPIC=bus/#

# Bus capacity (used for occupancy % calculation).
# Must match the frontend CONFIG.busCapacity in public/app.js (default 16).
BUS_CAPACITY=16

# Set to any value to enable SQLite query logging
# DB_VERBOSE=1

# ============================================
# AUTH (admin section)
# ============================================
# JWT signing secret. REQUIRED in production. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# Session lifetime in hours (default 12)
# AUTH_JWT_TTL_HOURS=12

# Cookie name (default sus_session)
# AUTH_COOKIE_NAME=sus_session

# Set to 1 ONLY for local http:// development. In production over HTTPS leave unset.
# AUTH_INSECURE_COOKIE=1

# Used by `node scripts/create-admin.js` to seed the first admin without arguments.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-now
# ADMIN_NAME=Your Name
