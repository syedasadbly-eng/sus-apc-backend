# ============================================
# SUS APC Backend — Environment Variables
# ============================================
# Copy this file to .env and edit as needed.
# All values have sensible defaults in server.js.

# Server
PORT=3001

# Database (SQLite file path)
DB_PATH=./apc_data.db

# MQTT Broker (HiveMQ Cloud)
MQTT_HOST=492260d5d94c4b4e87ade94ae81925e6.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=sus-dashboard
MQTT_PASS=SuS-Mqtt#2026!Secure
MQTT_TOPIC=bus/#

# Bus capacity (used for occupancy % calculation).
# Must match the frontend CONFIG.busCapacity in public/app.js (default 16).
BUS_CAPACITY=16

# Set to any value to enable SQLite query logging
# DB_VERBOSE=1

# ---- Welfare development interface (branch welfare-dev) ----
# Leave FEATURE_WELFARE unset in production. See welfare/INTEGRATION.md.
# FEATURE_WELFARE=true
# MQTT_ENABLED=false          # set false on dev instances so they do not read the live feed
# WELFARE_STALE_SEC=600
# WELFARE_OFFLINE_SEC=1800
# WELFARE_STUCK_MIN=45
# WELFARE_STUCK_KM=2
# WELFARE_LONE_SUSTAIN_SEC=300
# WELFARE_LATE_FROM=20
# WELFARE_LATE_TO=6
# WELFARE_EOS_SEC=300
# WELFARE_STATIONARY_KPH=3
# WELFARE_COOLDOWN_SEC=600
# WELFARE_DEPOTS=[{"name":"Depot","lat":44.02302,"lng":-92.46657,"radiusM":180,"buses":["515"]}]
# WELFARE_TERMINI=[]
# WELFARE_ALLOW_SIM=true      # event injection + purge. NEVER set on a client-facing service.
